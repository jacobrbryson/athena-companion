# Athena Companion — environment variables.
# Vite inlines VITE_* vars at BUILD time. For Cloud Run, pass them as Docker
# build args (see cloudbuild.yaml), not as runtime env vars.

# Base URL of the proxy_service (auth + API + WebSocket).
#   - Local dev: leave EMPTY (the Vite dev server proxies to :8080, same-origin).
#   - Production: the public proxy_service URL. Also add THIS app's origin to the
#     proxy's CORS_ALLOWED_ORIGINS so the credentialed cookie is accepted.
VITE_PROXY_BASE=

# Google OAuth web client ID (public). The Companion origin (e.g.
# http://localhost:3100 and the deployed URL) must be listed under
# "Authorized JavaScript origins" for this client in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=12367074465-eg00iem3k5nfsnh7v13j2rltql3c7nqg.apps.googleusercontent.com

# Unity WebGL build location (same-origin /unity, reverse-proxied to the bucket).
VITE_UNITY_ASSET_BASE=/unity
UNITY_UPSTREAM=https://storage.googleapis.com/assets-athena-app

# Local dev only: where the Vite dev server forwards /auth, /api, /ws.
VITE_DEV_PROXY_TARGET=http://localhost:8080
